[Term]
id: UBERON:0016378
name: ileocolic lymph node
namespace: uberon
def: "One of the lymph nodes that form a chain around the ileocolic artery." [http://en.wikipedia.org/wiki/Ileocolic_lymph_nodes]
synonym: "ileocecocolic lymph node" NARROW [http://ncicb.nci.nih.gov/xml/owl/EVS/Ileocecocolic_Lymph_Node, MA:0003065]
synonym: "nodi lymphoidei ileocolici" EXACT LATIN [http://en.wikipedia.org/wiki/Ileocolic_lymph_nodes]
xref: FMA:16611
