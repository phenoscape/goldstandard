disjoint_from: UBERON:0011814 ! non-neurogenic ectodermal placode
relationship: develops_from UBERON:2007013 ! preplacodal ectoderm
relationship: has_potential_to_developmentally_contribute_to UBERON:0001714 ! cranial ganglion
relationship: has_potential_to_developmentally_contribute_to UBERON:0001785 ! cranial nerve
property_value: curator_notes "Includes: trigeminal, otic, lateral line and epibranchial placodes." xsd:string
