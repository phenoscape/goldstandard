is_a: UBERON:0005291 ! embryonic tissue
is_a: UBERON:0010313 ! neural crest-derived structure
is_a: UBERON:0013765 ! digestive system element
relationship: develops_from UBERON:0010354 ! Reichert's cartilage pre-cartilage condensation
relationship: part_of UBERON:0001557 ! upper respiratory tract
