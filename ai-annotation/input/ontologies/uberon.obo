[Term]
id: UBERON:2007001
name: dorso-rostral cluster
namespace: uberon/phenoscape-anatomy
def: "Early-forming telencephalic neural cluster. Neurons of the dorso-rostral cluster (drc) extend axons to form the supra-optic tract (SOT) and the anterior commissure (AC). Ross et al., 1992." [ZFIN:curator]
synonym: "dorsorostral cluster" EXACT [TAO:0007001]
synonym: "drc" EXACT [TAO:0007001]
