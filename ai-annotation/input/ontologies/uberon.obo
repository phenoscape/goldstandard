[Term]
id: UBERON:0006604
name: lamina orbitonasalis
namespace: uberon
def: "Cranial cartilage which is bilaterally paired and develops as a dorsal plate-like projection of the anterolateral ethmoid plate, which are oriented perpendicular to the ethmoid plate. It fuses dorsally to the taenia marginalis anterior, and it joins the ethmoid cartilage medially." [ZFA:0001503]
synonym: "laminas orbitonasalis" EXACT [ZFA:0001503]
xref: AAO:0000262
xref: TAO:0001503
xref: ZFA:0001503
