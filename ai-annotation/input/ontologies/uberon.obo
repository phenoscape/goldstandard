is_a: UBERON:0010313 ! neural crest-derived structure
is_a: UBERON:0013685 ! foramen of skull
relationship: conduit_for UBERON:0004646 ! infraorbital artery
relationship: conduit_for UBERON:0018408 ! infra-orbital nerve
relationship: part_of UBERON:0002397 ! maxilla

[Term]
id: UBERON:0018408
name: infra-orbital nerve
namespace: uberon
def: "A branch of the maxillary nerve that enters the infraorbital canal. This nerve innervates the lower eyelid, upper lip, and part of the vestibule and exits the infraorbital foramen of the maxilla." [http://en.wikipedia.org/wiki/Infraorbital_nerve]
synonym: "infra-orbital nerve" RELATED [http://en.wikipedia.org/wiki/Infraorbital_nerve]
synonym: "infraorbital nerve" EXACT [FMA:52978]
synonym: "infraorbital portion" RELATED [http://en.wikipedia.org/wiki/Infraorbital_nerve]
