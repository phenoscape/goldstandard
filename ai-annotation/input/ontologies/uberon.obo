property_value: external_definition "An organ involved in red blood cell filtration and immune response.[AAO]" xsd:string {date_retrieved="2012-06-20", external_class="AAO:0010395", ontology="AAO", source="AAO:BMZ"}
property_value: function_notes "It synthesizes antibodies in its white pulp and removes, from blood and lymph node circulation, antibody-coated bacteria along with antibody-coated blood cells" xsd:string
