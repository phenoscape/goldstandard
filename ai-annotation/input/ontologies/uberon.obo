relationship: has_muscle_origin UBERON:0000981 ! femur
relationship: part_of UBERON:0001377 ! quadriceps femoris
property_value: external_definition "Origin: anterior and lateral surfaces of femur; insertion: patella, common tendon of quadriceps femoris; innervation: femoral; action, extends leg[BTO:0002542]." xsd:string {source="BTO:0002542"}

