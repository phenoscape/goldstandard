is_a: CL:0000737 ! striated muscle cell
relationship: develops_from CL:0000515 ! skeletal muscle myoblast
created_by: tmeehan
creation_date: 2010-09-24T01:13:01Z

[Term]
id: CL:0002373
name: growth hormone releasing hormone secreting cell
namespace: cell
