[Typedef]
id: anterior_to
name: anterior_to
namespace: spatial
namespace: uberon
def: "x anterior_to y iff x is further along the antero-posterior axis than y, towards the head. An antero-posterior axis is an axis that bisects an organism from head end to opposite end of body or tail." [BSPO:cjm]
def: "x anterior_to y iff x is further along the antero-posterior axis than y, towards the head. An antero-posterior axis is an axis that bisects an organism from head end to opposite end of body or tail: bearer" [http://orcid.org/0000-0002-6601-2165]
def: "x anterior_to y iff x is further along the antero-posterior axis than y, towards the head. An antero-posterior axis is an axis that bisects an organism from head end to opposite end of body or tail: bearer" [BSPO:cjm]
def: "x anterior_to y iff x is further along the antero-posterior axis than y, towards the head. An antero-posterior axis is an axis that extends through an organism from head end to opposite end of body or tail." [BSPO:cjm]
synonym: "rostral_to" EXACT []
xref: BSPO:0000096
xref: FBcv:0000039
xref: FBql:00005863
property_value: seeAlso FBcv:0000039
property_value: seeAlso FBql:00005863
is_transitive: true
inverse_of: posterior_to ! posterior_to
created_by: cjm
creation_date: 2009-07-31T02:15:46Z

