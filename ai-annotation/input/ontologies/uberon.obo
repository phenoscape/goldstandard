[Term]
id: UBERON:0008248
name: echinoderm pyloric cecum
name: pyloric cecum
namespace: uberon
def: "The pyloric ceca (or digestive glands) and the cardiac stomach produce digestive enzymes in starfishes. Digested material is absorbed through the pyloric ceca for transport to the rest of the body. Each pyloric cecum extends the length of each arm." [BTO:0002120]
synonym: "pyloric caecum" EXACT [BTO:0002120]
synonym: "pyloric cecum" EXACT [BTO:0002120]
