property_value: homology_notes "In the primitive vertebrate heart the four chambers are: 1. Sinus venosus (...) 2. Atrium (...) 3. Ventricle (...) 4. Conus arteriosus (...).[well established][VHOG]" xsd:string {date_retrieved="2012-09-17", external_class="VHOG:0000177", ontology="VHOG", source="http://bgee.unil.ch/", source="ISBN:978-0721676678 Romer AS, Vertebrate body (1970) p.428"}
