[Term]
id: UBERON:2007002
name: ventro-rostral cluster
namespace: uberon/phenoscape-anatomy
def: "Early-forming neural cluster located in the rostral diencephalon. At 19 h, axons arising from the vrc grow caudally to pioneer the tract of the postoptic commissure (TPOC). Ross et al., 1992." [ZFIN:curator]
synonym: "ventrorostral cluster" EXACT [TAO:0007002]
synonym: "vrc" EXACT [TAO:0007002]
