relationship: never_in_taxon NCBITaxon:8827
relationship: part_of UBERON:0010388 ! proximal segment of rib
property_value: external_definition "Posteriorly directed process (occasionally directed anteriorly) usually associated with the rib (sometimes with the transverse process) of the third vertebra; they provide the origin of the mm serratus superior, medius, and inferior.[AAO]" xsd:string {date_retrieved="2012-06-20", external_class="AAO:0000741", ontology="AAO", source="AAO:Pugener_2002"}

