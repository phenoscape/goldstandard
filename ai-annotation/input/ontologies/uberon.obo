synonym: "nucleus paramedianus dorsalis" RELATED LATIN [NeuroNames:735]
synonym: "nucleus paramedianus posterior" RELATED LATIN [NeuroNames:735]
synonym: "nucleus reticularis paramedianus myelencephali" RELATED LATIN [NeuroNames:735]
synonym: "nzcleo reticular paramediano dorsal@es" RELATED [NeuroNames:735]
synonym: "posterior paramedian nucleus" EXACT [FMA:72581]
xref: DHBA:12597
xref: FMA:72581
xref: http://braininfo.rprc.washington.edu/centraldirectory.aspx?ID=735
